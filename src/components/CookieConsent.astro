---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[999] hidden flex-col items-center justify-between gap-4 p-4 shadow-2xl sm:flex-row bg-blue-600 dark:bg-orange-600 text-white"
  dir="rtl"
>
  <p class="text-center text-sm sm:text-right">
    نستخدم ملفات تتبع الاستخدام لضمان تقديم أفضل تجربة تصفح ممكنة. باستمرارك في استخدام الموقع، فإنك توافق على 
    <a href="/privacy" class="font-bold underline hover:text-gray-200">سياسة الخصوصية</a> الخاصة بنا.
  </p>
  <div class="flex flex-shrink-0 gap-4">
    <button
      id="accept-cookies"
      class="rounded bg-white px-6 py-2 text-sm font-bold text-gray-900 transition-colors hover:bg-gray-200"
    >
      موافق
    </button>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('accept-cookies');

    if (banner && acceptBtn) {
      const consent = localStorage.getItem('cookieConsent');
      
      if (!consent) {
        banner.classList.remove('hidden');
        banner.classList.add('flex');
      }

      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      });
    }
  });
</script>
