---
---

<div
  id="cookie-modal-overlay"
  class="fixed inset-0 z-[999] hidden items-center justify-center p-4 pointer-events-none"
  dir="rtl"
>
  <div
    class="relative w-full max-w-md rounded-xl border border-border bg-[#fdfdfd] dark:bg-[#212737] p-6 shadow-2xl pointer-events-auto"
  >
    <div class="mb-5 text-center">
      <h3 class="mb-3 text-xl font-bold text-skin-accent">إشعار الخصوصية</h3>
      <p class="text-sm text-skin-base leading-relaxed">
        نحن نستخدم ملفات تعريف الارتباط لتحسين تجربتك. استمرارك في التصفح يعني موافقتك على ذلك.
        <br />
        <a href="/privacy" class="text-skin-accent hover:underline font-bold mt-1.5 inline-block">سياسة الخصوصية</a>
      </p> 
    </div>
    <div class="flex justify-center">
      <button
        id="accept-cookies"
        class="w-full rounded bg-[#0f75b1] dark:bg-[#ed6506] px-6 py-2.5 text-sm font-bold text-white transition-colors hover:opacity-80 sm:w-auto cursor-pointer"
      >
        موافق
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const overlay = document.getElementById('cookie-modal-overlay');
    const acceptBtn = document.getElementById('accept-cookies');

    if (overlay && acceptBtn) {
      const consent = localStorage.getItem('cookieConsent');
      
      if (!consent) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        // إضافة لون خلفية خفيف جداً للشاشة وراء النافذة لكي تبرز بشكل أجمل
        overlay.style.backgroundColor = "rgba(0, 0, 0, 0.4)";
      }

      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      });
    }
  });
</script>
