---
---

<div
  id="cookie-modal-overlay"
  class="fixed inset-0 z-[999] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
  dir="rtl"
>
  <div
    class="relative w-full max-w-md rounded-lg border border-border bg-skin-fill p-6 shadow-2xl"
  >
    <div class="mb-4 text-center">
      <h3 class="mb-2 text-xl font-bold text-skin-accent">نقدر خصوصيتك</h3>
      <p class="text-sm text-skin-base leading-relaxed">
        نستخدم ملفات تتبع الاستخدام لضمان تقديم أفضل تجربة تصفح ممكنة، وتحليل حركة المرور. باستمرارك في استخدام الموقع، فإنك توافق على 
        <a href="/privacy" class="text-skin-accent hover:underline font-bold">سياسة الخصوصية</a>.
      </p>
    </div>
    <div class="flex justify-center">
      <button
        id="accept-cookies"
        class="w-full rounded bg-skin-accent px-6 py-2.5 text-sm font-bold text-skin-inverted transition-colors hover:opacity-80 sm:w-auto"
      >
        موافق ومتابعة
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const overlay = document.getElementById('cookie-modal-overlay');
    const acceptBtn = document.getElementById('accept-cookies');

    if (overlay && acceptBtn) {
      const consent = localStorage.getItem('cookieConsent');
      
      if (!consent) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden'; // لمنع التمرير خلف النافذة
      }

      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = ''; // إعادة تفعيل التمرير
      });
    }
  });
</script>
