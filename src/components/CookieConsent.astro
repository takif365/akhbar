---
---

<div
  id="cookie-modal-overlay"
  class="fixed inset-0 z-[999] hidden items-center justify-center p-4 pointer-events-none"
  dir="rtl"
>
  <div
    class="relative w-full max-w-md rounded-xl border border-border bg-skin-fill p-6 shadow-2xl backdrop-blur-md bg-opacity-95 pointer-events-auto"
  >
    <div class="mb-5 text-center">
      <h3 class="mb-3 text-xl font-bold text-skin-accent">إشعار الخصوصية</h3>
      <p class="text-sm text-skin-base leading-relaxed">
        لتحسين تجربتك في تصفح الموقع، نحن نستخدم ملفات تعريف الارتباط. استمرارك في التصفح يعني موافقتك على ذلك وعلى 
        <a href="/privacy" class="text-skin-accent hover:underline font-bold mr-1">سياسة الخصوصية</a>.
      </p>
    </div>
    <div class="flex justify-center">
      <button
        id="accept-cookies"
        class="w-full rounded bg-skin-accent px-6 py-2.5 text-sm font-bold text-skin-inverted transition-colors hover:opacity-80 sm:w-auto cursor-pointer"
      >
        حسناً، فهمت
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const overlay = document.getElementById('cookie-modal-overlay');
    const acceptBtn = document.getElementById('accept-cookies');

    if (overlay && acceptBtn) {
      const consent = localStorage.getItem('cookieConsent');
      
      if (!consent) {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
      }

      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      });
    }
  });
</script>
