---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 z-50 hidden w-full flex-col items-center justify-between gap-4 border-t border-border bg-skin-fill p-4 shadow-lg sm:flex-row"
  dir="rtl"
>
  <p class="text-center text-sm text-skin-base sm:text-right">
    نستخدم ملفات تتبع الاستخدام لضمان تقديم أفضل تجربة تصفح ممكنة. باستمرارك في استخدام الموقع، فإنك توافق على 
    <a href="/privacy" class="text-skin-accent hover:underline">سياسة الخصوصية</a> الخاصة بنا.
  </p>
  <div class="flex flex-shrink-0 gap-4">
    <button
      id="accept-cookies"
      class="rounded bg-skin-accent px-6 py-2 text-sm font-bold text-skin-inverted transition-colors hover:opacity-80"
    >
      موافق
    </button>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('accept-cookies');

    if (banner && acceptBtn) {
      const consent = localStorage.getItem('cookieConsent');
      
      if (!consent) {
        banner.classList.remove('hidden');
        banner.classList.add('flex');
      }

      acceptBtn.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'true');
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      });
    }
  });
</script>
