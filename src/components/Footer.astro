---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row sm:py-4">
    
    <div class="my-2 flex flex-col items-center whitespace-nowrap text-sm sm:flex-row">
      <span dir="ltr">&#169; {currentYear} - .المحتوى محمي بحقوق النشر</span>
    </div>

    <div class="my-4 flex flex-wrap justify-center gap-4 text-sm sm:my-0">
      <a href="/privacy" class="hover:text-skin-accent transition-colors">سياسة الخصوصية</a>
      <a href="/terms" class="hover:text-skin-accent transition-colors">شروط الاستخدام</a>
      <a href="/about" class="hover:text-skin-accent transition-colors">من نحن</a>
      <a href="/contact" class="hover:text-skin-accent transition-colors">اتصل بنا</a>
    </div>

  </div>
</footer>
